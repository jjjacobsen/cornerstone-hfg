{
  "dependencies": {
    "@vinext/cloudflare": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.4.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.127.1"
  },
  "name": "cornerstone-hfg",
  "packageManager": "npm@11.19.0",
  "private": true,
  "scripts": {
    "build": "vinext build && rm -f dist/server/.dev.vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "dev": "vinext dev",
    "preview": "npm run build && npm run start --",
    "start": "wrangler dev --config dist/server/wrangler.json --env-file \"$INIT_CWD/.dev.vars\" --persist-to \"$INIT_CWD/.wrangler/state\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to \"$INIT_CWD/.wrangler/state\"",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --persist-to \"$INIT_CWD/.wrangler/state\" --file .private/seed.sql",
    "password:hash": "node scripts/hash-password.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
